# Example environment — copy to .env for local development and fill in real values.
# NEVER commit a real .env file. All values below are placeholders, not secrets.

POSTGRES_USER=cnr_user
POSTGRES_PASSWORD=change-me-in-your-local-env
POSTGRES_DB=crime_network
POSTGRES_PORT=5432

NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-in-your-local-env
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# Optional Phase 4 overrides (defaults shown):
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_DATABASE=neo4j

BACKEND_PORT=8000
FRONTEND_PORT=5173

# Backend: required for JWT auth (fail-closed when missing).
JWT_SECRET=change-me-to-a-long-random-string
# Backend: allowed browser origin(s) for CORS, comma-separated.
FRONTEND_URL=http://localhost:5173
# Frontend: browser-reachable backend URL (baked at container start).
VITE_API_BASE_URL=http://localhost:8000
